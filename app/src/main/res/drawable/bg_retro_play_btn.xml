<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#FFD8BE96"
                android:startColor="#FFFFF7E6" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#FF96380A"
                android:startColor="#FFD45E1C" />
        </shape>
    </item>
</layer-list>
