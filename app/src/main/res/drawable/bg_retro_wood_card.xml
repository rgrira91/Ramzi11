<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="135"
                android:centerColor="#FF9B5A2B"
                android:endColor="#FF753E19"
                android:startColor="#FFB5713B" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:centerColor="#FFF8ECD4"
                android:endColor="#FFF2DFBF"
                android:startColor="#FFFDF5E6" />
            <stroke
                android:width="1dp"
                android:color="#FFD7B98E" />
        </shape>
    </item>
</layer-list>
