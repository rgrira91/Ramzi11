<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NeonWave" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/neon_magenta</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/neon_cyan</item>
        <item name="colorOnSecondary">@color/bg_cosmic_deep</item>
        <item name="android:colorBackground">@color/bg_cosmic_deep</item>
        <item name="colorSurface">@color/bg_card_glass</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="NeonBottomSheetTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/NeonBottomSheetStyle</item>
    </style>

    <style name="NeonBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/bg_cosmic_mid</item>
    </style>

    <style name="RoundedAlbumArt16" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="RoundedAlbumArt12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
