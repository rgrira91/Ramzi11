<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sticky_scroll_mini_player"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_neon_sub_card"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:visibility="gone">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/sticky_mini_art"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="@string/cd_album_art"
        android:scaleType="centerCrop"
        android:src="@drawable/img_default_album_art"
        app:shapeAppearanceOverlay="@style/RoundedAlbumArt12"
        app:strokeColor="@color/neon_cyan"
        app:strokeWidth="1dp" />

    <LinearLayout
        android:id="@+id/sticky_mini_info_tap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sticky_mini_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/default_track_title"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sticky_mini_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/default_track_artist"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/sticky_mini_btn_prev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_previous"
        android:padding="10dp"
        android:src="@drawable/ic_skip_previous"
        app:tint="@color/text_primary" />

    <ImageButton
        android:id="@+id/sticky_mini_btn_play_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_play_button_ring"
        android:contentDescription="@string/cd_play_pause"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play" />

    <ImageButton
        android:id="@+id/sticky_mini_btn_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_next"
        android:padding="10dp"
        android:src="@drawable/ic_skip_next"
        app:tint="@color/text_primary" />
</LinearLayout>
