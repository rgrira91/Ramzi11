<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preset_tile_root"
    android:layout_width="76dp"
    android:layout_height="76dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_preset_tile_normal"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/preset_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/section_eq_presets"
        android:src="@drawable/ic_preset_electronic" />

    <TextView
        android:id="@+id/preset_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/preset_electronic"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
