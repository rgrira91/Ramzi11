<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/liquid_glass_stage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Fanned Stacked Album Covers Showcase -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/liquid_art_prev"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:alpha="0.82"
            android:clickable="true"
            android:contentDescription="@string/cd_previous"
            android:focusable="true"
            android:rotation="-10"
            android:scaleType="centerCrop"
            android:src="@drawable/img_default_album_art"
            android:translationX="-92dp"
            android:translationY="14dp"
            app:shapeAppearanceOverlay="@style/RoundedAlbumArt16"
            app:strokeColor="#AAFFFFFF"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/liquid_art_next"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:alpha="0.82"
            android:clickable="true"
            android:contentDescription="@string/cd_next"
            android:focusable="true"
            android:rotation="10"
            android:scaleType="centerCrop"
            android:src="@drawable/img_default_album_art"
            android:translationX="92dp"
            android:translationY="14dp"
            app:shapeAppearanceOverlay="@style/RoundedAlbumArt16"
            app:strokeColor="#AAFFFFFF"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/liquid_art_center"
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:contentDescription="@string/cd_album_art"
            android:elevation="10dp"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/img_default_album_art"
            app:shapeAppearanceOverlay="@style/RoundedAlbumArt16"
            app:strokeColor="#EE67E8F9"
            app:strokeWidth="2.5dp" />
    </FrameLayout>

    <!-- Iridescent Frosted Liquid Glass Control Shell -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-14dp"
        android:background="@drawable/bg_liquid_glass_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp">

        <!-- Left Waveform / More Button | Center Title & Artist | Right Heart Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/liquid_btn_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_liquid_glass_circle"
                android:contentDescription="@string/cd_more_options"
                android:padding="12dp"
                android:src="@drawable/ic_waveform_badge"
                app:tint="#FF312E81" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/liquid_track_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="@string/default_track_title"
                    android:textColor="#FF1E1B4B"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/liquid_track_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/default_track_artist"
                    android:textColor="#FF4F46E5"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/liquid_btn_favorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_liquid_glass_circle"
                android:contentDescription="@string/cd_favorite"
                android:padding="12dp"
                android:src="@drawable/ic_heart_outline"
                app:tint="#FF7C3AED" />
        </LinearLayout>

        <!-- Iridescent SeekBar & Timestamps -->
        <SeekBar
            android:id="@+id/liquid_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:progressDrawable="@drawable/seekbar_liquid_progress"
            android:splitTrack="false"
            android:thumb="@drawable/seekbar_liquid_thumb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/liquid_current_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/time_zero"
                android:textColor="#FF4338CA"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/liquid_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_zero"
                android:textColor="#FF4338CA"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Frosted Glass Bubble Transport Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/liquid_btn_shuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_liquid_glass_circle"
                android:contentDescription="@string/cd_shuffle"
                android:padding="12dp"
                android:src="@drawable/ic_shuffle"
                app:tint="#FF312E81" />

            <ImageButton
                android:id="@+id/liquid_btn_prev"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_liquid_glass_circle"
                android:contentDescription="@string/cd_previous"
                android:padding="13dp"
                android:src="@drawable/ic_skip_previous"
                app:tint="#FF1E1B4B" />

            <ImageButton
                android:id="@+id/liquid_btn_play_pause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="14dp"
                android:background="@drawable/bg_liquid_play_btn"
                android:contentDescription="@string/cd_play_pause"
                android:padding="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/liquid_btn_next"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_liquid_glass_circle"
                android:contentDescription="@string/cd_next"
                android:padding="13dp"
                android:src="@drawable/ic_skip_next"
                app:tint="#FF1E1B4B" />

            <ImageButton
                android:id="@+id/liquid_btn_repeat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_liquid_glass_circle"
                android:contentDescription="@string/cd_repeat"
                android:padding="12dp"
                android:src="@drawable/ic_repeat"
                app:tint="#FF312E81" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
