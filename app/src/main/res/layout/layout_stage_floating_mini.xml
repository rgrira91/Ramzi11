<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_player_stage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_expanded_card"
    android:orientation="vertical"
    android:padding="18dp"
    android:visibility="gone">

    <!-- Top Row: Square Album Art + Title/Artist + Collapse & Heart + Mirrored Spectrum -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/floating_album_art"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/cd_album_art"
            android:scaleType="centerCrop"
            android:src="@drawable/img_default_album_art"
            app:shapeAppearanceOverlay="@style/RoundedAlbumArt16"
            app:strokeColor="#AA38BDF8"
            app:strokeWidth="1.5dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/floating_track_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:text="@string/default_track_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/floating_track_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/default_track_artist"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/floating_btn_collapse"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_toggle_floating_mini"
                    android:padding="12dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/floating_btn_favorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_favorite"
                    android:padding="12dp"
                    android:src="@drawable/ic_heart_outline" />
            </LinearLayout>

            <com.example.ui.views.NeonWaveformView
                android:id="@+id/floating_waveform_view"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- SeekBar & Timestamps -->
    <SeekBar
        android:id="@+id/floating_seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:progressDrawable="@drawable/seekbar_neon_progress"
        android:splitTrack="false"
        android:thumb="@drawable/seekbar_neon_thumb" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <TextView
            android:id="@+id/floating_current_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/time_zero"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/floating_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/time_zero"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Transport Controls Row + Quick More Options & Lyrics -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/floating_btn_shuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_shuffle"
            android:padding="12dp"
            android:src="@drawable/ic_shuffle" />

        <ImageButton
            android:id="@+id/floating_btn_prev"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_previous"
            android:padding="12dp"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/floating_btn_play_pause"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_floating_play_btn"
            android:contentDescription="@string/cd_play_pause"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/floating_btn_next"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_next"
            android:padding="12dp"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/floating_btn_repeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_repeat"
            android:padding="12dp"
            android:src="@drawable/ic_repeat" />

        <ImageButton
            android:id="@+id/floating_btn_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_more_options"
            android:padding="12dp"
            android:src="@drawable/ic_more_horiz"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
