<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_mini_docked_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginHorizontal="14dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_floating_mini_glass"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:visibility="gone">

    <!-- Compact Top Row: Cover Art + Title/Artist + Expand Chevron -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/mini_bar_album_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_album_art"
            android:scaleType="centerCrop"
            android:src="@drawable/img_default_album_art"
            app:shapeAppearanceOverlay="@style/RoundedAlbumArt12"
            app:strokeColor="#AA8B5CF6"
            app:strokeWidth="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_bar_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/default_track_title"
                android:textColor="#FF1E1B4B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mini_bar_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/default_track_artist"
                android:textColor="#FF5B567D"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/mini_bar_btn_expand"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_toggle_floating_mini"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_up"
            app:tint="#FF1E1B4B" />
    </LinearLayout>

    <!-- SeekBar & Timestamps -->
    <SeekBar
        android:id="@+id/mini_bar_seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:progressDrawable="@drawable/seekbar_liquid_progress"
        android:splitTrack="false"
        android:thumb="@drawable/seekbar_liquid_thumb" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <TextView
            android:id="@+id/mini_bar_current_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/time_zero"
            android:textColor="#FF4C486E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/mini_bar_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/time_zero"
            android:textColor="#FF4C486E"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Transport Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/mini_bar_btn_shuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_shuffle"
            android:padding="12dp"
            android:src="@drawable/ic_shuffle"
            app:tint="#FF312E81" />

        <ImageButton
            android:id="@+id/mini_bar_btn_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_previous"
            android:padding="12dp"
            android:src="@drawable/ic_skip_previous"
            app:tint="#FF1E1B4B" />

        <ImageButton
            android:id="@+id/mini_bar_btn_play_pause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="14dp"
            android:background="@drawable/bg_liquid_glass_circle"
            android:contentDescription="@string/cd_play_pause"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            app:tint="#FF1E1B4B" />

        <ImageButton
            android:id="@+id/mini_bar_btn_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_next"
            android:padding="12dp"
            android:src="@drawable/ic_skip_next"
            app:tint="#FF1E1B4B" />

        <ImageButton
            android:id="@+id/mini_bar_btn_repeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_repeat"
            android:padding="12dp"
            android:src="@drawable/ic_repeat"
            app:tint="#FF312E81" />
    </LinearLayout>
</LinearLayout>
