<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_badge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sheet_title_options"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Quick Actions Row: Lyrics, Playlist, Share -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_lyrics"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/btn_open_lyrics"
                android:textColor="@color/neon_cyan"
                android:textSize="11.5sp"
                app:strokeColor="@color/neon_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_add_playlist"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:text="@string/btn_add_to_playlist"
                android:textColor="@color/neon_magenta"
                android:textSize="11.5sp"
                app:strokeColor="@color/neon_magenta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_share"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/btn_share_track"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                app:strokeColor="@color/stroke_subtle" />
        </LinearLayout>

        <!-- Quick Jump Row: -10s / +10s -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_jump_back"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/btn_jump_back_10"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                app:strokeColor="@color/stroke_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_jump_fwd"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/btn_jump_fwd_10"
                android:textColor="@color/neon_magenta"
                android:textSize="12sp"
                app:strokeColor="@color/stroke_subtle" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_btn_ui_studio"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ui_studio_title"
            android:textColor="@color/neon_cyan"
            android:textSize="12.5sp"
            app:icon="@drawable/ic_ui_style"
            app:iconTint="@color/neon_cyan"
            app:strokeColor="@color/neon_cyan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_btn_youtube_music"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_youtube_music"
            android:textColor="@color/neon_magenta"
            android:textSize="12.5sp"
            app:icon="@drawable/ic_youtube"
            app:iconTint="@color/neon_magenta"
            app:strokeColor="@color/neon_magenta" />

        <!-- Modern Quick Studios: Drive Mode, Audio Lab & Insights, Story Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_drive_mode"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/btn_drive_mode"
                android:textColor="@color/neon_cyan"
                android:textSize="11sp"
                app:icon="@drawable/ic_car_drive"
                app:iconTint="@color/neon_cyan"
                app:strokeColor="@color/neon_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_audio_lab"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:text="@string/btn_audio_lab_insights"
                android:textColor="@color/neon_magenta"
                android:textSize="11sp"
                app:icon="@drawable/ic_insights"
                app:iconTint="@color/neon_magenta"
                app:strokeColor="@color/neon_magenta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_story_card"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/btn_share_story_card"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:strokeColor="@color/stroke_subtle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_stage_3d"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/btn_stage_3d"
                android:textColor="@color/neon_cyan"
                android:textSize="11.5sp"
                app:icon="@drawable/ic_waveform_badge"
                app:iconTint="@color/neon_cyan"
                app:strokeColor="@color/neon_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_harmonic_next"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/btn_harmonic_next"
                android:textColor="@color/neon_magenta"
                android:textSize="11.5sp"
                app:icon="@drawable/ic_skip_next"
                app:iconTint="@color/neon_magenta"
                app:strokeColor="@color/neon_magenta" />
        </LinearLayout>

        <!-- Pro Audio FX Sliders & Toggles -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sheet_pro_fx"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_neon_sub_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/label_bass_boost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fx_bass_boost"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek_bass_boost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progressDrawable="@drawable/seekbar_neon_progress"
                android:thumb="@drawable/seekbar_neon_thumb" />

            <TextView
                android:id="@+id/label_virtualizer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/fx_virtualizer"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek_virtualizer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressDrawable="@drawable/seekbar_neon_progress"
                android:thumb="@drawable/seekbar_neon_thumb" />

            <TextView
                android:id="@+id/label_loudness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/fx_loudness"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek_loudness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressDrawable="@drawable/seekbar_neon_progress"
                android:thumb="@drawable/seekbar_neon_thumb" />

            <TextView
                android:id="@+id/label_balance_lr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/fx_balance_lr"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek_balance_lr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100"
                android:progressDrawable="@drawable/seekbar_neon_progress"
                android:thumb="@drawable/seekbar_neon_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fx_spatial_8d"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_spatial_8d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fx_auto_device_eq"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_auto_device_eq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fx_haptic_bass"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_haptic_bass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fx_edge_glow"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_edge_glow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fx_color_pulse_buttons"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_color_pulse_buttons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fx_glass_nav_bar"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_glass_nav_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fx_skip_silence"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_skip_silence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fx_smooth_fade"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_smooth_fade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fx_dynamic_theme"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_dynamic_theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fx_auto_resume"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_auto_resume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Crossfade Duration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/sheet_crossfade"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_crossfade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cf_0"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/crossfade_off" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cf_2"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/crossfade_2s" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cf_4"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/crossfade_4s" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cf_6"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/crossfade_6s" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cf_10"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/crossfade_10s" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Playback Speed -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sheet_playback_speed"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_speed_075"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.75x" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_speed_100"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="1.0x" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_speed_125"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.25x" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_speed_150"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.5x" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Audio Pitch -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sheet_playback_pitch"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_pitch_085"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.85x" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_pitch_100"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="1.0x" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_pitch_115"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.15x" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Sleep Timer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/sheet_sleep_timer"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_sleep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sleep_off"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_off" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sleep_15"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_15m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sleep_30"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_30m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sleep_60"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_60m" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Media & Self-Adaptive Device Optimization -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sheet_adaptive_opt_title"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_neon_sub_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/sheet_optimizer_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_opt_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_opt_auto"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_mode_auto" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_opt_performance"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_mode_performance" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_opt_eco"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_mode_eco" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/opt_anti_stutter"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_anti_stutter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/opt_audio_offload"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_audio_offload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_optimize_ram"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/opt_clean_ram_btn"
                android:textColor="@color/neon_cyan"
                app:strokeColor="@color/neon_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_restore_removed"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/neon_magenta"
                android:visibility="gone"
                app:strokeColor="@color/neon_magenta" />
        </LinearLayout>

        <!-- Track Details -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sheet_track_details"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheet_track_info_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_neon_sub_card"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp" />

        <!-- Permissions Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sheet_permissions_status"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_neon_sub_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/sheet_permissions_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_request_all_perms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/btn_grant_permissions"
                app:backgroundTint="@color/neon_violet" />
        </LinearLayout>

        <!-- Java & Code Assist Project Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sheet_code_assist_info"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_neon_sub_card"
            android:padding="12dp"
            android:text="@string/code_assist_details"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
