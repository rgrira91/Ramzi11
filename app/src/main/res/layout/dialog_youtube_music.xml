<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cosmic_canvas"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_badge" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_youtube"
            app:tint="@color/neon_magenta" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yt_deck_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yt_deck_subtitle"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/yt_btn_mode_player"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_badge"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:paddingHorizontal="10dp"
            android:text="@string/yt_tab_player"
            android:textColor="@color/neon_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/yt_btn_mode_browse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_badge"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:paddingHorizontal="10dp"
            android:text="@string/yt_tab_browse"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Paste URL or Search YouTube Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_neon_sub_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <EditText
            android:id="@+id/yt_input_url_or_query"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/yt_input_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/yt_btn_go"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:minWidth="64dp"
            android:paddingHorizontal="12dp"
            android:text="@string/yt_btn_go"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            app:strokeColor="@color/neon_cyan" />
    </LinearLayout>

    <!-- Official Embedded Player Container -->
    <LinearLayout
        android:id="@+id/yt_player_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:background="@drawable/bg_neon_sub_card"
            android:padding="2dp">

            <WebView
                android:id="@+id/yt_player_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/yt_player_empty_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#D90B0E1D"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/yt_empty_player_hint"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </FrameLayout>

        <!-- Transport Deck -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_neon_sub_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/yt_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/yt_deck_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/yt_track_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/yt_ready_status"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

            <SeekBar
                android:id="@+id/yt_seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="1000"
                android:progressDrawable="@drawable/seekbar_neon_progress"
                android:thumb="@drawable/seekbar_neon_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/yt_time_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_zero"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/yt_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_zero"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/yt_btn_prev"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_previous"
                    android:padding="12dp"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/yt_btn_play_pause"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="@drawable/bg_play_button_ring"
                    android:contentDescription="@string/cd_play_pause"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/yt_btn_next"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_next"
                    android:padding="12dp"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/yt_btn_loop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_repeat"
                    android:padding="12dp"
                    android:src="@drawable/ic_repeat_one"
                    app:tint="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Embedded YouTube Search / Browse WebView -->
    <FrameLayout
        android:id="@+id/yt_browse_container"
        android:layout_width="match_parent"
        android:layout_height="312dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_neon_sub_card"
        android:padding="2dp"
        android:visibility="gone">

        <WebView
            android:id="@+id/yt_browse_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Saved YouTube Queue -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/yt_queue_title"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_neon_sub_card"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/yt_queue_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
